#!/usr/bin/env bash
# session-idle - what "verify" means for interactably.
#
# Contract: the agent declares a task done by committing its work to the branch.
# This hook verifies that committed work; exit 0 passes and commits anything the
# agent left uncommitted, non-zero fails and stdout/stderr is fed back to the
# agent as its next instructions.

set -euo pipefail
cd "${WORKTREE_PATH:-$(git rev-parse --show-toplevel)}" || exit 1

# Install the worktree's dependencies (node_modules is not committed).
pnpm install --prefer-offline

# Type-check and run the node:test suite. Both must pass.
pnpm check
pnpm test

# Verification passed: commit anything the agent left uncommitted (idempotent).
if [ -n "$(git status --porcelain)" ]; then
  git add -A
  git -c user.name=orch -c user.email=orch@localhost \
      commit -q -m "orch: session-idle verification passed"
fi
exit 0
