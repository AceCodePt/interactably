{
  "name": "interactably",
  "version": "0.1.0",
  "description": "A trigger grammar and host for customized built-in web components.",
  "type": "module",
  "main": "./dist/interactably.js",
  "module": "./dist/interactably.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/interactably.js"
    },
    "./cdn/*": {
      "types": "./dist/cdn/*.d.ts",
      "import": "./dist/cdn/*.js"
    },
    "./dist/cdn/*": {
      "types": "./dist/cdn/*.d.ts",
      "import": "./dist/cdn/*.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "dist/cdn/*.js",
    "dist/interactably.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AceCodePt/interactably.git"
  },
  "homepage": "https://acecodept.github.io/interactably/",
  "bugs": {
    "url": "https://github.com/AceCodePt/interactably/issues"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test \"**/*.test.ts\"",
    "build": "rolldown -c && tsc -p tsconfig.build.json && node scripts/rewrite-dts-imports.mjs",
    "build:site": "node scripts/build-site.mjs"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "customized-built-ins",
    "interaction",
    "declarative",
    "headless"
  ],
  "license": "MIT",
  "dependencies": {
    "auto-wc": "^0.1.6",
    "tsyntax": "^0.1.4"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.2",
    "jsdom": "^30.0.1",
    "rolldown": "^1.2.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.3.4",
      "onFail": "download"
    }
  }
}
